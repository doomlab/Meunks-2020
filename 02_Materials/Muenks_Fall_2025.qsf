":{"Display":"It is important to me that I do well on science tasks."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":7,"Answers":{"1":{"Display":"1 - strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6 - strongly agree"}},"AnswerOrder":[1,2,3,4,5,6],"ChoiceDataExportTags":false,"QuestionID":"QID18"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"person_question_4","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":" ","Choices":{"1":{"Display":"I think the professor in this class would endorse gender stereotypes."},"2":{"Display":"I think the professor in this class would treat male and female students differently in class. "},"3":{"Display":"I think the professor in this class believes that men are better at math than women."},"4":{"Display":"There is a good possibility that the professor in this class has different expectations for male and female students."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":9,"Answers":{"1":{"Display":"1 - strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"},"8":{"Display":"8 - strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7,8],"ChoiceDataExportTags":false,"QuestionID":"QID19"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Cl