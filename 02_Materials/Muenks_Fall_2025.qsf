"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"In this study, we are interested in students' opinions about different classes at Missouri State...","TertiaryAttribute":null,"Payload":{"QuestionText":"In this study, we are interested in students' opinions about different classes at Missouri State University. First, you will watch a short video clip from the first day of class from a section of Introduction to Astronomy (AST 115) recorded in the Fall 2016 semester. After watching this video clip you will be asked questions about your memory for the video, so make sure to pay attention. <br><br>Please adjust your browser to full screen and turn up your volume so you can hear the professor speak.","DefaultChoices":false,"DataExportTag":"Q26","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this study, we are interested in students' opinions about different classes at Missouri State...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID26"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Did you answer randomly at any point during this study?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did you answer randomly at any point during this study?<br>","DefaultChoices":false,"DataExportTag":"attn_check_2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did you answer randomly at any point during this study?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID27"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"attention_check","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":" ","Choices":{"1":{"Display":"Please mark strongly agree"},"2":{"Display":"Please mark strongly disagree"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":7,"Answers":{"1":{"Display":"1 - strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6 - strongly agree"}},"AnswerOrder":[1,2,3,4,5,6],"ChoiceDataExportTags":false,"QuestionID":"QID28"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q20","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"I consent"},"2":{"Display":"I do not consent"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID29"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"<iframe frameborder=\"0\" height=\"360\" scrolling=\"no\" src=\"https:\/\/www.youtube.com\/embed\/jwI2LG3DRgs\" width=\"640\"><\/iframe>","DefaultChoices":false,"DataExportTag":"fixed_mindset","QuestionID":"QID30","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q22","QuestionType":"Meta","Selector":"Browser","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Browser","TextEntry":1},"2":{"Display":"Version","TextEntry":1},"3":{"Display":"Operating System","TextEntry":1},"4":{"Display":"Screen Resolution","TextEntry":1},"5":{"Display":"Flash Version","TextEntry":1},"6":{"Display":"Java Support","TextEntry":1},"7":{"Display":"User Agent","TextEntry":1}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"Consent to Participate in a Research Study\u00a0 Missouri State University\u00a0 School of Mental Health an.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><strong><span style=\"font-size:16px;\"><span style=\"vertical-align:baseline\">Consent to Participate in a Research Study&nbsp;<\/span><br \/>\n<span style=\"vertical-align:baseline\">Missouri State University&nbsp;<\/span><br \/>\n<span style=\"vertical-align:baseline\">School of Mental Health and Behavioral Sciences&nbsp;<\/span><br \/>\n<span style=\"vertical-align:baseline\">&nbsp;<\/span><br \/>\nIRB-FY2026-137<br \/>\n<span style=\"vertical-align:baseline\">CREPlication: Classroom Edition&nbsp;<\/span><br \/>\n<span style=\"vertical-align:baseline\">Principal Investigator: Dr. Melissa Fallone&nbsp;<\/span><br \/>\n<span style=\"vertical-align:baseline\">Primary Study Contact: Dr. Erin Buchanan&nbsp;<\/span><\/span><\/strong><\/span><\/div>\n<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b><u>Introduction&nbsp;<\/u><\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">You have been asked to participate in a research study that is part of a large-scale replication project and aims to understand how professors&rsquo; characteristics may influence student performance. Before you agree to participate in this study, it is important that you read and understand the following explanation of the study and the procedures involved. Please note that in order to participate in this study, you must be at least 18 years old. The investigator will also explain the project to you in detail. If you have any questions about the study or your role in it, be sure to ask the investigator. If you have more questions later, Dr. Erin Buchanan&mdash;the person responsible for this study&mdash;will answer them for you. You may contact the investigator(s):&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>Principal Investigator:<\/b> Dr. Melissa Fallone&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Email: <a href=\"mailto:MFallone@missouristate.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">MFallone@missouristate.edu<\/span><\/a>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Phone: (417) 836-6528&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>Primary Study Contact:<\/b> Dr. Erin Buchanan&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Email: <a href=\"mailto:ebuchanan@harrisburgu.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">ebuchanan@harrisburgu.edu<\/span><\/a> (<a href=\"mailto:erinbuchanan@missouristate.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">erinbuchanan@missouristate.edu<\/span><\/a>)&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>Researchers:&nbsp;<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Emma Bebe | <a href=\"mailto:eb27s@MissouriState.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">eb27s@MissouriState.edu<\/span><\/a>&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Jayden Coalson | <a href=\"mailto:jc298s@MissouriState.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">jc298s@MissouriState.edu<\/span><\/a>&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Allie German | <a href=\"mailto:ag58s@missouristate.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">ag58s@MissouriState.edu<\/span><\/a>&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Emily Green | <a href=\"mailto:eg694s@MissouriState.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">eg694s@MissouriState.edu<\/span><\/a>&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Grant Howison | <a href=\"mailto:gph73s@MissouriState.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><span style=\"text-decoration:none\">gph73s@MissouriState.edu<\/span><\/a>&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">In order to take part in this study, you will need to provide your consent to be involved in the study. Taking part in this study is entirely your choice. You can stop participating at any time. If you decide to take part in this study then later change your mind, you do not have to provide a reason for choosing not to continue. There will be no negative consequences for ending your participation. The survey should take 15 to 20 minutes.&nbsp;<br \/>\n&nbsp;&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>Purpose of this Study<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">The reason for this study is to examine how professors&rsquo; characteristics influence student performance. You have been asked to participate because you are registered at Missouri State University. This study will examine professors&rsquo; beginning-of-semester course expectations and students&rsquo; expected experience in the class.&nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>Description of Procedures<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">If you decide to participate in this study, you will view a video of a professor speaking and then answer questions.&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>What are the risks?&nbsp;<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">We estimate that the potential risks of this study are minimal. Because the study mimics what you experience as a college student, there are little to no expected risks, harms, or discomforts outside of what is experienced in daily life. &nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>What are the benefits?<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">It is not anticipated that you will experience any direct benefits from this study. However, your participation in this research will help investigators identify patterns that may lead to better student outcomes in the future. You may also receive course credit or extra credit depending on your course.&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>How will my privacy be protected?&nbsp;<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">Your name will only be used to grant credit for participation. No identifying information would be maintained with your answers on the questionnaire. The information gathered will be accessible only by the investigators. You will not be identified by name in any publications that result from this research.&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>Consent to Participate<\/b>&nbsp;<\/span><\/span><br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">If you want to participate in this study, <i>CREPlication: Classroom Edition, <\/i>you are required to read the following information and check the appropriate box.&nbsp;&nbsp;<\/span><\/span><span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\">I have read and understand the information in this form. I have been encouraged to ask questions and all of my questions have been answered to my satisfaction. I have also been informed that I can withdraw from this study at any time. By choosing &ldquo;yes,&rdquo; I voluntarily agree to participate in this study.&nbsp;&nbsp;<\/span><\/span><br \/>\n<br \/>\n<span style=\"font-size:12pt\"><span style=\"vertical-align:baseline\"><b>If you have any questions about your rights as a research participant, concerns or complaints about this research, or you want to talk to someone other than the researcher, please contact MSU&rsquo;s Office of Research Administration at (417) 836-5972 or\u202f<\/b><a href=\"mailto:IRB@missouristate.edu\" rel=\"noopener\" style=\"color:inherit\" target=\"_blank\"><b><span style=\"text-decoration:none\">IRB@missouristate.edu<\/span><\/b><\/a><b>. Regular office hours are M-F 8:00 A.M. to 5:00 P.M., after hour messages will be returned the next business day.<\/b>&nbsp;<\/span><\/span><\/span><br \/>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Q23","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Consent to Participate in a Research Study\u00a0 Missouri State University\u00a0 School of Mental Health an...","Choices":{"1":{"Display":"Yes, I have read and understood the above information and agree to participate in the CREPlication: Classroom Edition study"},"2":{"Display":"No, I do not agree to participate in the CREPlication: Classroom Edition study"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID32"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q24","QuestionID":"QID33","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":128,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":84,"NextAnswerId":1}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q25","QuestionID":"QID34","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":158,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":52,"NextAnswerId":1}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID35","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q26","QuestionID":"QID35","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":84,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":56,"NextAnswerId":1}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID36","SecondaryAttribute":"Please indicate your gender:","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate your gender:","DataExportTag":"Q27","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate your gender:","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Prefer not to say"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID36"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"Please indicate your race: 0 = White, East Asian, and Southeast Asian students; 1 = Black, Hispan...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate your race:<br>0 = White, East Asian, and Southeast Asian students; 1 = Black, Hispanic, Indian\nSubcontinent, Native American, Mixed race, Middle Eastern, and Pacific Islander students)\n<br>","DataExportTag":"Q28","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate your race: 0 = White, East Asian, and Southeast Asian students; 1 = Black, Hispan...","Choices":{"1":{"Display":"American Indian or Alaska Native"},"2":{"Display":"Asian"},"3":{"Display":"Black or African American"},"4":{"Display":"Native Hawaiian or Other Pacific Islander"},"5":{"Display":"White"},"6":{"Display":"Multiple"},"7":{"Display":"Other"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID37"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID38","SecondaryAttribute":"The video you viewed was not an actual classroom recording but a scripted scenario created for re...","TertiaryAttribute":null,"Payload":{"QuestionText":"The video you viewed was not an actual classroom recording but a scripted scenario created for research purposes.&nbsp; This approach is commonly used in research to create realistic classroom situations. The purpose of this was to understand how students form impressions of classroom environments based on the mindset of the instructor.&nbsp; No students were involved and the instructor in the video is not employed by Missouri State University.","DefaultChoices":false,"DataExportTag":"Q29","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The video you viewed was not an actual classroom recording but a scripted scenario created for re...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID38"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"prof_questions","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":" ","Choices":{"1":{"Display":"The professor in this class seems to believe that students have a certain amount of intelligence, and they really can\u2019t do much to change it."},"2":{"Display":"The professor in this class seems to believe that students either \u201chave it\u201d or they don\u2019t."},"3":{"Display":"The professor in this class seems to believe that every student can learn new things and significantly grow their intelligence."},"4":{"Display":"The professor in this class seems to believe that some students are smart, while others are not."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":7,"Answers":{"1":{"Display":"1 - strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6 - strongly agree"}},"AnswerOrder":[1,2,3,4,5,6],"ChoiceDataExportTags":false,"QuestionID":"QID7"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"prof_questions_2","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":" ","Choices":{"1":{"Display":"You can learn new things, but you can\u2019t really change your basic intelligence."},"2":{"Display":"You can change even your basic intelligence level considerably."},"3":{"Display":"Your intelligence is something about you that you can\u2019t change very much."},"4":{"Display":"No matter how much intelligence you have, you can always change it quite a bit."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":7,"Answers":{"1":{"Display":"1 - strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6 - strongly agree"}},"AnswerOrder":[1,2,3,4,5,6],"ChoiceDataExportTags":false,"QuestionID":"QID9"}},{"SurveyID":"SV_6SF09ojcueuqWAm","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}